# Supply-chain hardening for a security-sensitive project.
#
# Never run dependency lifecycle scripts (preinstall/install/postinstall).
# Install scripts are the most common npm malware vector, and nothing in this
# toolchain needs them. If a future dependency genuinely requires one, run it
# explicitly and document why instead of removing this line.
ignore-scripts=true

# Record exact versions in package.json so every upgrade is an explicit,
# reviewable change (the lockfile pins transitive dependencies).
save-exact=true
