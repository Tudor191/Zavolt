{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"],
  "settings": {
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react/jsx-no-target-blank": "error",
    "react/button-has-type": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/anchor-is-valid": ["error", { "components": ["Link"], "specialLink": ["to"] }],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ],

    "react/no-danger": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-restricted-properties": [
      "error",
      {
        "property": "innerHTML",
        "message": "Building HTML from strings is an XSS sink. Render through React instead."
      },
      {
        "property": "outerHTML",
        "message": "Building HTML from strings is an XSS sink. Render through React instead."
      },
      {
        "property": "insertAdjacentHTML",
        "message": "Building HTML from strings is an XSS sink. Render through React instead."
      },
      {
        "object": "document",
        "property": "write",
        "message": "document.write is an XSS sink. Render through React instead."
      },
      {
        "object": "document",
        "property": "writeln",
        "message": "document.writeln is an XSS sink. Render through React instead."
      }
    ],

    "no-console": "error",
    "no-alert": "error",
    "unicorn/no-document-cookie": "error",
    "no-restricted-globals": [
      "error",
      {
        "globals": [
          {
            "name": "localStorage",
            "message": "Web storage is readable by any script on the page. Never store secrets, keys or vault data in it; see SECURITY.md."
          },
          {
            "name": "sessionStorage",
            "message": "Web storage is readable by any script on the page. Never store secrets, keys or vault data in it; see SECURITY.md."
          }
        ],
        "checkGlobalObject": true
      }
    ],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",

    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
      "plugins": ["vitest"]
    },
    {
      "files": ["e2e/**", "*.config.ts"],
      "env": {
        "node": true
      },
      "rules": {
        // Steps that drive a browser must run one after another.
        "no-await-in-loop": "off"
      }
    }
  ]
}
